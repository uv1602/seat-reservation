{
  "name": "seat-reservation",
  "version": "1.0.0",
  "description": "High-concurrency seat reservation system with TypeScript and TypeORM",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "node cmd/burst.js",
    "typeorm": "typeorm-ts-node-esm",
    "migration:generate": "typeorm-ts-node-esm migration:generate",
    "migration:run": "typeorm-ts-node-esm migration:run",
    "docker:build": "docker build -t seat-reservation:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app"
  },
  "keywords": [
    "seat",
    "reservation",
    "concurrency",
    "fastify",
    "typeorm",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fastify": "^4.24.3",
    "fastify-plugin": "^4.5.1",
    "@fastify/swagger": "^8.10.1",
    "@fastify/swagger-ui": "^1.9.1",
    "pg": "^8.11.3",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "prom-client": "^15.0.0",
    "uuid": "^9.0.1",
    "typeorm": "^0.3.17",
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "ts-loader": "^9.5.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
